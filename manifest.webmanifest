  "lang": "en",
  "dir": "ltr",
  "icons": [
    { "src": "/assets/lifecycle-os-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/lifecycle-os-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/lifecycle-os-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/assets/lifecycle-os-mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],

# Netlify
.netlify/
.cache/

# Vercel CLI link state (org/project IDs — not secrets, but no need to track)
.vercel/

# Node / npm
node_modules/
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# Env / secrets — NEVER commit these
.env
.env.local
.env.*.local
supabase/.env

# Build outputs
dist/
build/
.next/
data/catalog/

# Logs
*.log

# Local downloads / generated artefacts
*.html.bak
test-output/

# Playwright run artifacts (traces, screenshots, HTML report — regenerable, never source)
test-results/
tests/report/
playwright-report/
# studio.spec.js writes these inside a try/catch and asserts NOTHING against
# them - they are debug output, not baselines. Tracked, they regenerate on
# every run and conflicted on every merge, which is how six binary files came
# to need hand resolution during a routine sync.
tests/screenshots/

# Compiled analysis exports (keep the README, ignore the workbooks)
output/*.xlsx
output/*.csv

# Linked-DB pointer written by the dashboard (may hold an anon key — not tracked)
data/linked-db.public.json

# Reference projects / accidental nested clones — never commit these
knickgasm-sneaker-architect/
marketing_mailers__html_architect/

# Supabase CLI runtime files
supabase/.temp/

# Claude Code local config (keep shared project commands tracked)
.claude/*
!.claude/commands/
.claude/settings.local.json

# Credentials and PATs
*.pat
*.token
.tokens/
.env*.local
.vercel

# Auto-subscribe worker screenshots (audit artifacts, not source)
workers/.artifacts/

# local dashboard build artifacts
scratchpad/
.env*

# Python bytecode cache
__pycache__/
*.pyc

# ── Customer data never belongs in this repo (17 Aug 2026 audit) ───────────
# A sibling repo shipped 26,677 real customer records - names, emails, street
# addresses, phone numbers, spend - in a public tree, plus a third party's
# $48k Meta Ads export. Neither belonged to us to publish. These patterns are
# the cheap half of making that unrepeatable; the expensive half is not putting
# the file there in the first place.
input/
uploaded_by_*/
*_customers.csv
*_customer_export*.csv
*-Ads-*.csv

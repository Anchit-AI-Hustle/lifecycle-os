############################################################################
# Lifecycle OS — self-hosted Supabase configuration
#
#   cp selfhost/.env.example selfhost/.env
#   node scripts/selfhost-keys.js --write        # fills every secret below
#
# Every variable docker-compose.yml references is defined here (a test fails
# otherwise). Lines you MUST edit by hand are marked EDIT. Everything under
# "Secrets" is written by selfhost-keys.js; do not invent values for those.
############################################################################


############
# Database mode                                                          EDIT
############
# local     Postgres runs in this compose (`db` service, supabase/postgres).
#           Start with:  docker compose --profile local-db up -d
# external  Postgres is a managed instance (Neon). `db` is not started.
#           Start with:  docker compose up -d
#           and run scripts/selfhost-migrate.sh --bootstrap BEFORE the first
#           `up`, because a plain Postgres has none of the Supabase roles,
#           schemas or functions the services assume exist.
# scripts/selfhost-up.sh reads this and runs the right command; it also
# refuses a .env whose other values contradict the mode.
DB_MODE=local

############
# Postgres connection — the six values every service's URL is built from
############
# local: keep `db` (the compose service name). external: the host from your
# Neon connection string, e.g. ep-cool-name-123456.eu-central-1.aws.neon.tech
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
# local: `postgres`. external: the Neon role from the connection string
# (e.g. neondb_owner) — a role created in the Neon CONSOLE, not with SQL,
# because only console/API-created roles carry REPLICATION and BYPASSRLS.
POSTGRES_USER=postgres
# local: generated by selfhost-keys.js (hex, so it is URL-safe inside the
# connection strings). external: the Neon role's password, URL-encoded if it
# contains anything outside [A-Za-z0-9._~-].
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
# disable for the local container. REQUIRE for Neon: it refuses plaintext.
POSTGRES_SSLMODE=disable
# Realtime takes a boolean rather than an sslmode. false local, true external.
REALTIME_DB_SSL=false

# Which role each service logs in as. The local image ships one role per
# service; a managed Postgres cannot create most of them (they need SUPERUSER,
# REPLICATION or BYPASSRLS to be granted), so in external mode set ALL of
# these to POSTGRES_USER. The bootstrap SQL creates only what PostgREST's
# role switching needs: anon, authenticated, service_role and authenticator.
AUTH_DB_USER=supabase_auth_admin
STORAGE_DB_USER=supabase_storage_admin
REALTIME_DB_USER=supabase_admin
META_DB_USER=postgres
STUDIO_DB_USER=postgres
# storage-api's "super user" for its own grants — `postgres` locally, your
# Neon role externally.
STORAGE_DB_SUPER_USER=postgres
# true locally (storage-api creates its roles as a superuser would). false
# externally: its installer grants `bypassrls`, which a managed Postgres
# refuses, so the bootstrap SQL creates the roles instead.
STORAGE_DB_INSTALL_ROLES=true
# Host port the LOCAL db is published on (loopback only) for pg_dump/psql.
POSTGRES_HOST_PORT=5432


############
# Secrets — written by: node scripts/selfhost-keys.js --write
############
# HS256 secret shared by GoTrue, PostgREST, Realtime and Storage. >= 32 chars.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
# ANON_KEY / SERVICE_ROLE_KEY are NOT random strings: they are JWTs signed with
# JWT_SECRET, payload {"role":"anon"|"service_role","iss":"supabase","iat","exp"}.
# PostgREST reads `role` to SET ROLE; Kong matches the literal key to the
# consumer ACL; GoTrue accepts `service_role` as admin. Regenerate all three
# together — a key signed with an old secret is silently rejected as 401.
ANON_KEY=
SERVICE_ROLE_KEY=
# Studio basic-auth at the gateway (alphanumerics only — the value is
# substituted into Kong's YAML).
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
# Realtime cookie/session signing. >= 64 chars.
SECRET_KEY_BASE=
# Realtime encrypts tenant secrets with this. EXACTLY 16 chars.
REALTIME_DB_ENC_KEY=
# Studio -> postgres-meta connection-string encryption. >= 32 chars.
PG_META_CRYPTO_KEY=
# Storage's S3-protocol endpoint credentials (unused by this app; storage-api
# still requires them to be set).
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
# Newer opaque key format (sb_publishable_… / sb_secret_…). Not used by this
# kit — the app and Kong use the HS256 JWTs above. Leave empty.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=


############
# URLs                                                                   EDIT
############
# The public origin the app will use as SUPABASE_URL. Behind Caddy this is
# https://<your-host>; without TLS (never for Google sign-in) http://<ip>:8000.
SUPABASE_PUBLIC_URL=http://localhost:8000
# GoTrue's external URL — SUPABASE_PUBLIC_URL + /auth/v1. It builds the Google
# callback (${API_EXTERNAL_URL}/callback) and email links from this.
API_EXTERNAL_URL=http://localhost:8000/auth/v1
# Where users land after sign-in: the app's canonical origin.
SITE_URL=https://lifecycle-os.anchit-tandon.com
# Comma-separated allowlist for signInWithOAuth({ redirectTo }) — auth.js
# passes location.origin + location.pathname, so allow the whole origin with
# a `/**` glob. Add preview origins here if previews must sign in.
ADDITIONAL_REDIRECT_URLS=https://lifecycle-os.anchit-tandon.com/**


############
# Auth (GoTrue)
############
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# Google sign-in — the provider auth.js uses.                             EDIT
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
# (Web application). Authorized redirect URI MUST be exactly
#   ${SUPABASE_PUBLIC_URL}/auth/v1/callback
# The client id/secret from that screen go here.
GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# SMTP (optional). Google sign-in needs no email; these only matter if you
# enable email/password accounts or invites. Leave the placeholders to keep
# GoTrue booting without a mail server.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=Lifecycle OS


############
# Gateway (Kong) — host ports
############
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443


############
# PostgREST
############
# Only `public` is exposed. Upstream adds graphql_public (pg_graphql, not used
# here) and Storage's schema is reached via /storage/v1, never via REST.
PGRST_DB_SCHEMAS=public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# Storage
############
FILE_SIZE_LIMIT=52428800
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub


############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=Lifecycle OS
STUDIO_DEFAULT_PROJECT=Lifecycle OS
# Optional: enables Studio's SQL assistant. Leave empty.
OPENAI_API_KEY=


############
# TLS (docker-compose.caddy.yml only)                                    EDIT
############
# The DNS name pointing at this box. Caddy obtains a Let's Encrypt cert for it.
PROXY_DOMAIN=db.example.org

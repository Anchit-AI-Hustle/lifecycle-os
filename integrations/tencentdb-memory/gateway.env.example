# TencentDB-Agent-Memory gateway environment — copy to gateway.env and fill in.
# The gateway distills raw turns into atoms/scenarios/persona using an LLM, so an
# LLM key is required for that pipeline. The vector store + capture/recall work
# locally (SQLite); only the distillation calls the LLM.

# ── LLM used for memory distillation (OpenAI-compatible) ──────────────────
TDAI_LLM_API_KEY=sk-your-key-here
TDAI_LLM_BASE_URL=https://api.openai.com/v1
TDAI_LLM_MODEL=gpt-4o

# ── Gateway bind + auth ───────────────────────────────────────────────────
MEMORY_TENCENTDB_GATEWAY_HOST=0.0.0.0
MEMORY_TENCENTDB_GATEWAY_PORT=8420
# Optional bearer token. If set, the MCP bridge must send the SAME value as
# TDAI_GATEWAY_API_KEY (see .mcp.json / your Claude MCP config).
TDAI_GATEWAY_API_KEY=

# Where the local SQLite memory + logs live inside the container/host.
MEMORY_TENCENTDB_LOG_DIR=/data/logs

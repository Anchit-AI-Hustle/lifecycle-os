<?xml version="1.0" encoding="UTF-8"?>
<!--
  The public surface of Lifecycle OS, and nothing else.

  Every URL here must be one that auth.js `isOpenPage()` serves signed-out AND
  that robots.txt allows. A sitemap entry for a gated page is a request to index
  a login wall.

  No <lastmod>: this file is hand-maintained and a date written here would be
  the date someone remembered to type, not the date the page changed. A wrong
  lastmod is worse than none — it teaches a crawler to ignore the field.

  The host is the one every other host redirects to (see vercel.json: both
  knickgasm.vercel.app and knickgasm-lifecycle-os.anchit-tandon.com redirect
  here), so this is the canonical origin, not a third front door.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://lifecycle-os.anchit-tandon.com/</loc>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://lifecycle-os.anchit-tandon.com/privacy.html</loc>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://lifecycle-os.anchit-tandon.com/terms.html</loc>
    <priority>0.3</priority>
  </url>
</urlset>

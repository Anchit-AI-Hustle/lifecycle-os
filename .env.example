# ── SIGN-IN: GOOGLE, THROUGH SUPABASE AUTH (2026-10-10) ──────────────────────
# Google is the ONLY sign-in (auth.js -> signInWithOAuth). The browser reads
# the project URL and its public key from /api/public-config.
#   SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY: the project's
#     URL and its anon and service_role keys (`supabase projects api-keys`).
# The two below are what `supabase config push` reads for
# [auth.external.google]. Without them (and without the provider ON in
# Authentication -> Providers -> Google) GoTrue answers 400 validation_failed
# "Unsupported provider: provider is not enabled", which auth.js reads from
# /auth/v1/settings first and says in a sentence. Mint a Web application OAuth
# client in Google Cloud; the only Authorized redirect URI is
# https://<project-ref>.supabase.co/auth/v1/callback. Runbook:
# docs/google-signin.md.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_SECRET_KEY=

# ── RETIRED: MOBILE NUMBER + 4-DIGIT PIN (2026-09-28 to 2026-10-10) ───────────
# Switched off. Nothing reads MOBILE_PIN_PEPPER(_PREVIOUS) to sign anyone in
# and DATABASE_URL no longer keeps accounts (op=enter answers 410). They may
# stay unset; leaving an old value set is harmless. CREDITS_COMP_PHONES is moot
# for the same reason: no phone account exists to be listed.
# MOBILE_PIN_PEPPER=
# MOBILE_PIN_PEPPER_PREVIOUS=
# DATABASE_URL=

# ── PUBLISHING & DELIVERABILITY (2026-08-18) ─────────────────────────────────
# All optional. Absent means that platform reports itself unconfigured rather
# than failing. Each platform ALSO needs a one-time app registration the
# operator cannot self-serve; see docs/publishing-and-deliverability.md.
META_APP_ID=
META_APP_SECRET=
# The Verify Token entered on the Meta app dashboard when the webhook callback
# (/api/brain?action=dispatch-webhook&provider=meta) is registered. Meta's GET
# verification request is answered only when hub.verify_token equals this;
# unset, every verification request is refused (403). Deliveries are verified
# with META_APP_SECRET (X-Hub-Signature-256 over the raw body), not with this.
META_WEBHOOK_VERIFY_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
KLAVIYO_OAUTH_CLIENT_ID=
KLAVIYO_OAUTH_CLIENT_SECRET=

# Per-deployment secret mixed with each WORKSPACE id to salt contact hashes
# (subscriber_engagement_scores, contact_touch_ledger). It never replaces the
# workspace id: one address hashes differently in every brand. Rotating it
# orphans existing hashes; they are recomputed on the next sync.
CONTACT_HASH_SALT=

# THE THREE SWITCHES. Nothing is dispatched unless all that apply are set:
#   1. this repo-wide kill switch (off by default)
#   2. per-workspace live publishing, toggled in the Integration Hub
#   3. the platform's own write switch: the read-only escape hatch for
#      Klaviyo/Shopify/WebEngage, and (2026-10-04) one per social-gateway
#      platform. Set to 1 to allow that platform's writes; anything else is off.
#      Reads need only LIVE_CONNECTORS. A paid write is still created PAUSED /
#      DRAFT / private, and turning it on is a separate live approval.
LIVE_CONNECTORS=
KLAVIYO_ALLOW_WRITES=
WEBENGAGE_ALLOW_WRITES=
META_ALLOW_WRITES=
TIKTOK_ALLOW_WRITES=
PINTEREST_ALLOW_WRITES=
YOUTUBE_ALLOW_WRITES=
GOOGLE_ADS_ALLOW_WRITES=

# ── SOCIAL INTEGRATION GATEWAY (2026-10-04) ──────────────────────────────────
# OAuth apps, one per platform; each needs its own review (see CLAUDE.md).
# TikTok Login Kit + Content Posting API. The client secret also verifies
# TikTok-Signature on webhook deliveries.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Seconds a TikTok delivery's timestamp may lag. This platform's own policy,
# not a TikTok number. Default 300.
TIKTOK_WEBHOOK_TOLERANCE_SECONDS=
# Pinterest app (API v5). Sent as HTTP Basic to the token endpoint.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# YouTube Data API v3 (a Google OAuth web client with offline access).
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Largest video the YouTube upload will fetch and relay, in bytes. This
# platform's own policy (a serverless function holds it in memory), default
# 104857600 (100 MB). Not a YouTube limit.
YOUTUBE_MAX_UPLOAD_BYTES=

# ── CREDITS (2026-08-24) ─────────────────────────────────────────────────────
# api/_shared/credit-catalog.js is the versioned source of truth for what each
# FEATURE costs in credits. These four are the parts an operator sets per
# deployment, without a deploy.

# What a recharge pack costs IN MONEY. The catalog deliberately ships no price:
# it depends on the operator's costs, market and currency, and a plausible
# figure committed to a public repo would read as a decided one. A pack with no
# price is NOT purchasable - the card says so and createOrder refuses with 409
# before writing an order nobody could settle.
#
# JSON, keyed by pack. `amount_minor` is the SMALLEST unit of that currency
# (paise, cents) - never a major-unit decimal, because money in a float is a
# rounding error waiting for a reconciliation. The minor-unit exponent is read
# from Intl, so a zero-decimal currency such as JPY is handled correctly.
# The credit_pack_prices table (migration 20260823170000) overrides this.
#   {"starter":{"currency":"INR","amount_minor":49900},"growth":{...}}
CREDIT_PACK_PRICES=

# Credits granted once per USER on first wallet touch. Per user, not per
# wallet: anyone can create unlimited workspaces, so a per-wallet trial would
# be an unlimited faucet. Default 500.
CREDIT_WELCOME_GRANT=

# Set to 1 to credit a pack the moment it is ordered, with no payment step.
# For a deployment with no processor connected that is deliberate self-service;
# on a public one it gives credits away. Off unless explicitly set.
CREDITS_ALLOW_SELF_SERVE=

# Comma-separated addresses that recharge free, matched WHOLE and
# case-insensitively against the VERIFIED session email - never a domain rule,
# which would grant free credits to every current and future employee of a
# company. Metering still applies, so their usage stays visible in the same
# ledger; only the top-up is free, and it is recorded as `comp_account` so it
# can never be read back as revenue.
CREDITS_COMP_ACCOUNTS=

# Comma-separated MOBILE NUMBERS that may hold a credit wallet (2026-09-29).
# The one sign-in is a mobile number and a PIN, and a phone sign-up is free,
# unverified and unlimited - so a wallet per number would be an unlimited
# faucet on this deployment's provider budget, and a phone account has NO
# wallet unless its number is listed here. Each entry is normalised to E.164
# through phone-rules.js before it is compared ("98765 43210", "+91 98765-43210"
# and "+919876543210" are one entry; a bare number takes the home country
# code), matched whole against the number on the VERIFIED session, never a
# prefix. A listed number holds one personal wallet, is metered on it exactly
# like everyone else, and recharges free (recorded as `comp_account`, never as
# revenue). The repo ships no number: this variable is the only door.
CREDITS_COMP_PHONES=

# ── PAYMENT GATEWAYS (api/_shared/payments-core.js, /payments) ──────────────
# All optional. Absent means the gateway reports itself not configured and
# every operation returns the exact request it WOULD make instead of failing.
# The platform owner registers once with each provider; see the Setup tab.
PAYMENTS_ENCRYPTION_KEY=        # 32 bytes, base64 or hex (openssl rand -base64 32). Without it no credential can be stored; plaintext storage is not offered.
PAYMENTS_PUBLIC_BASE_URL=       # The exact origin registered as the OAuth callback base with every provider.
STRIPE_CONNECT_CLIENT_ID=       # ca_… from the Connect OAuth settings.
STRIPE_SECRET_KEY=              # Platform secret key: code exchange, acting on connected accounts.
STRIPE_WEBHOOK_SECRET=          # whsec_… signing secret of the Connect webhook endpoint. Verifies Stripe-Signature on
                                # every delivery to /api/payments?op=webhook&gateway=stripe. Unset = every delivery
                                # REFUSED (503); verification is never skipped.
RAZORPAY_OAUTH_CLIENT_ID=       # Partner OAuth only. Absent = the merchant pastes a key id and secret instead.
RAZORPAY_OAUTH_CLIENT_SECRET=
PAYPAL_PARTNER_CLIENT_ID=
PAYPAL_PARTNER_CLIENT_SECRET=
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_ENV=                     # live | sandbox
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=

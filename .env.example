
# ── PUBLISHING & DELIVERABILITY (2026-08-18) ─────────────────────────────────
# All optional. Absent means that platform reports itself unconfigured rather
# than failing. Each platform ALSO needs a one-time app registration the
# operator cannot self-serve; see docs/publishing-and-deliverability.md.
META_APP_ID=
META_APP_SECRET=
# The Verify Token entered on the Meta app dashboard when the webhook callback
# (/api/brain?action=dispatch-webhook&provider=meta) is registered. Meta's GET
# verification request is answered only when hub.verify_token equals this;
# unset, every verification request is refused (403). Deliveries are verified
# with META_APP_SECRET (X-Hub-Signature-256 over the raw body), not with this.
META_WEBHOOK_VERIFY_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
KLAVIYO_OAUTH_CLIENT_ID=
KLAVIYO_OAUTH_CLIENT_SECRET=

# Per-deployment salt for contact hashes in subscriber_engagement_scores.
# Rotating it orphans existing hashes; they are recomputed on the next sync.
CONTACT_HASH_SALT=

# THE THREE SWITCHES. Nothing is dispatched unless all that apply are set:
#   1. this repo-wide kill switch (off by default)
#   2. per-workspace live publishing, toggled in the Integration Hub
#   3. for Klaviyo/Shopify/WebEngage only, the read-only escape hatch below
LIVE_CONNECTORS=
KLAVIYO_ALLOW_WRITES=
WEBENGAGE_ALLOW_WRITES=

# ── CREDITS (2026-08-24) ─────────────────────────────────────────────────────
# api/_shared/credit-catalog.js is the versioned source of truth for what each
# FEATURE costs in credits. These four are the parts an operator sets per
# deployment, without a deploy.

# What a recharge pack costs IN MONEY. The catalog deliberately ships no price:
# it depends on the operator's costs, market and currency, and a plausible
# figure committed to a public repo would read as a decided one. A pack with no
# price is NOT purchasable - the card says so and createOrder refuses with 409
# before writing an order nobody could settle.
#
# JSON, keyed by pack. `amount_minor` is the SMALLEST unit of that currency
# (paise, cents) - never a major-unit decimal, because money in a float is a
# rounding error waiting for a reconciliation. The minor-unit exponent is read
# from Intl, so a zero-decimal currency such as JPY is handled correctly.
# The credit_pack_prices table (migration 20260823170000) overrides this.
#   {"starter":{"currency":"INR","amount_minor":49900},"growth":{...}}
CREDIT_PACK_PRICES=

# Credits granted once per USER on first wallet touch. Per user, not per
# wallet: anyone can create unlimited workspaces, so a per-wallet trial would
# be an unlimited faucet. Default 500.
CREDIT_WELCOME_GRANT=

# Set to 1 to credit a pack the moment it is ordered, with no payment step.
# For a deployment with no processor connected that is deliberate self-service;
# on a public one it gives credits away. Off unless explicitly set.
CREDITS_ALLOW_SELF_SERVE=

# Comma-separated addresses that recharge free, matched WHOLE and
# case-insensitively against the VERIFIED session email - never a domain rule,
# which would grant free credits to every current and future employee of a
# company. Metering still applies, so their usage stays visible in the same
# ledger; only the top-up is free, and it is recorded as `comp_account` so it
# can never be read back as revenue.
CREDITS_COMP_ACCOUNTS=

# ── PAYMENT GATEWAYS (api/_shared/payments-core.js, /payments) ──────────────
# All optional. Absent means the gateway reports itself not configured and
# every operation returns the exact request it WOULD make instead of failing.
# The platform owner registers once with each provider; see the Setup tab.
PAYMENTS_ENCRYPTION_KEY=        # 32 bytes, base64 or hex (openssl rand -base64 32). Without it no credential can be stored; plaintext storage is not offered.
PAYMENTS_PUBLIC_BASE_URL=       # The exact origin registered as the OAuth callback base with every provider.
STRIPE_CONNECT_CLIENT_ID=       # ca_… from the Connect OAuth settings.
STRIPE_SECRET_KEY=              # Platform secret key: code exchange, acting on connected accounts.
STRIPE_WEBHOOK_SECRET=          # whsec_… signing secret of the Connect webhook endpoint. Verifies Stripe-Signature on
                                # every delivery to /api/payments?op=webhook&gateway=stripe. Unset = every delivery
                                # REFUSED (503); verification is never skipped.
RAZORPAY_OAUTH_CLIENT_ID=       # Partner OAuth only. Absent = the merchant pastes a key id and secret instead.
RAZORPAY_OAUTH_CLIENT_SECRET=
PAYPAL_PARTNER_CLIENT_ID=
PAYPAL_PARTNER_CLIENT_SECRET=
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_ENV=                     # live | sandbox
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
